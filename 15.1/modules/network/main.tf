# Модуль network — создаёт ТОЛЬКО пустую VPC-сеть, без подсетей.
#
# ОТЛИЧИЕ от модуля vpc из прошлого проекта (k8s-install/terraform/modules/vpc):
# там сеть и ОДНА подсеть создавались одним модулем, потому что там всегда
# нужна была ровно одна подсеть. Здесь нужны ДВЕ подсети (public/private),
# причём private зависит от route table, которая сама зависит от NAT-инстанса
# в public-подсети — то есть подсети не могут быть созданы "одним пакетом",
# им нужен явный порядок. Поэтому сеть и подсеть разделены на два модуля.
resource "yandex_vpc_network" "vpc_network" {
  name = var.network_name

  labels = {
    environment = var.environment
  }
}
